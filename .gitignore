# Roblox place files. These are 20+ MB binaries that change wholesale on every save, so a
# committed one is unrecoverable weight in the history forever. The reviewable mirror of the
# place is `src/`, extracted from the binary with `tools/rbxl_extract.py` -- commit that.
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# Python caches from tools/
__pycache__/
*.pyc

# Studio session lock, present only while the place is open
*.rbxl.lock

# API keys and local agent auth. `.gemini/settings.json` IS committed -- it carries the MCP wiring
# and no secret -- but a key must never join it. Put keys in .env or in the user-level ~/.gemini/.
.env
.env.*
.gemini/.credentials*
.gemini/oauth*

# regenerated by tools/manifest_build.py on every hash sweep -- never a source of truth
tools/manifest.json

# ===== AGENT SCRATCH AT THE REPO ROOT =====
# Two agents work in this tree now (see GEMINI.md), and both drop working files beside the source:
# a plan, a snippet staged for a Studio push, a JSON payload, a block of old code held while it is
# replaced. None of it is source and none of it is reviewable, but it accumulates fast enough to
# bury the real changes in `git status` -- which is the one place a collision between the two of
# them shows up. Ignored rather than deleted: they are still there on disk if a push needs redoing.
/implementation_plan.md
/task.md
/inject*.lua
/replace_*.lua
/push.py
/temp.lua
/temp.py
/temp_*.txt
/temp_*.json

# Scratch from the Studio<->disk reconciliation: manifests, pulled copies, receiver logs
tools/_*
/push_node.js
/push*.js

# personal per-machine overrides for this project; the shared hook config lives in settings.json
.claude/settings.local.json
